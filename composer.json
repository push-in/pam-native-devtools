{
    "name": "pushinbr/pam-native-devtools",
    "description": "Deterministic temporal replay, state, network and frame diagnostics for PAM Native.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "pushinbr/pam-native": "^0.8 || ^0.9 || ^0.10 || ^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\DevTools\\": "src/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --level=9 --no-progress",
        "test": "php tests/run.php",
        "verify": ["@analyse", "@test"]
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
